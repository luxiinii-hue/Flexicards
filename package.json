{
  "name": "flexicards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Custom Magic: The Gathering card generator with print-ready PDF export",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "jspdf": "^2.5.2",
    "mana-font": "^1.16.0",
    "nanoid": "^5.0.8",
    "opentype.js": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.2.0",
    "svg2pdf.js": "^2.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "gh-pages": "^6.2.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.5"
  }
}
